{
  "name": "palette-system-builder-guide",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "prepare:docs": "node scripts/prepare-docs.mjs",
    "start": "node scripts/prepare-docs.mjs --locale en && docusaurus start",
    "build": "npm run prepare:docs && docusaurus build && node scripts/check-build.mjs",
    "serve": "docusaurus serve",
    "write-translations": "npm run prepare:docs && docusaurus write-translations"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@fontsource/ibm-plex-sans": "5.2.8",
    "github-slugger": "2.0.0",
    "prism-react-renderer": "2.4.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "serialize-javascript": "7.1.3",
    "tinypool": "2.1.2",
    "uuid": "11.1.1"
  }
}
