{
  "name": "sima-neat",
  "displayName": "Palette Neat Development Environment",
  "description": "VS Code extension for SiMa Neat SDK workspaces.",
  "version": "0.0.1",
  "publisher": "sima-neat",
  "license": "UNLICENSED",
  "icon": "media/neat-logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/sima-neat/sdk.git",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Themes"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:simaNeat.panel",
    "onCommand:simaNeat.showPanel"
  ],
  "contributes": {
    "commands": [
      {
        "command": "simaNeat.gettingStarted",
        "title": "SiMa Neat: Getting Started"
      },
      {
        "command": "simaNeat.showPanel",
        "title": "SiMa Neat: Show Panel"
      },
      {
        "command": "simaNeat.browseModels",
        "title": "SiMa Neat: Browse Models (develop)",
        "enablement": "simaNeat.modelRegistryAvailable"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "simaNeat",
          "title": "SiMa Neat",
          "icon": "media/neat-logo.png"
        }
      ]
    },
    "views": {
      "simaNeat": [
        {
          "id": "simaNeat.panel",
          "name": "Neat",
          "type": "webview"
        }
      ]
    },
    "themes": [
      {
        "label": "SiMa Neat Light",
        "uiTheme": "vs",
        "path": "./themes/sima-neat-light.json"
      },
      {
        "label": "SiMa Neat Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/sima-neat-dark.json"
      }
    ],
    "configurationDefaults": {
      "workbench.startupEditor": "none",
      "workbench.colorTheme": "SiMa Neat Light",
      "workbench.preferredLightColorTheme": "SiMa Neat Light",
      "workbench.preferredDarkColorTheme": "SiMa Neat Dark",
      "editor.fontFamily": "'IBM Plex Mono', monospace",
      "terminal.integrated.fontFamily": "'IBM Plex Mono', monospace"
    },
    "menus": {
      "commandPalette": [
        {
          "command": "simaNeat.browseModels",
          "when": "simaNeat.modelRegistryAvailable"
        }
      ]
    }
  }
}
