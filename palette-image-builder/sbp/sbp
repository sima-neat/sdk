#!/bin/sh
# sbp from a tree with pkgbuild/ and configs/packages/: PIB_SBP_SRC (a mounted checkout of
# swsoc-simaai-elxr-doc or swsoc-elxr), else /usr/share/pib, where the image will keep them once
# deps/artifacts.json pins a swsoc-simaai-elxr-doc commit that has them (the pinned one's configs/
# holds only images/). The tool and
# the package configs always come from the same tree, as in SiMa's CI (swsoc-elxr
# scripts/build_scripts/elxrPackage.sh uses the checkout's own pkgbuild/).
src="${PIB_SBP_SRC:-/usr/share/pib}"
if [ ! -f "$src/pkgbuild/sbp/cli.py" ]; then
    echo "sbp: no pkgbuild/sbp at $src; set PIB_SBP_SRC to a swsoc-simaai-elxr-doc or swsoc-elxr checkout (the pib launcher mounts it)" >&2
    exit 2
fi
PYTHONPATH="$src/pkgbuild${PYTHONPATH:+:$PYTHONPATH}" \
    exec python3 -c 'import sys; sys.argv[0] = "sbp"; from sbp.cli import cli; cli()' "$@"
