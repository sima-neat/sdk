#!/bin/sh
# sbp from a tree with pkgbuild/ and configs/packages/: PIB_PKGBUILD_SRC (a mounted checkout of
# swsoc-simaai-elxr-doc or swsoc-elxr), else /usr/share/pib/sbp-src, the image's own, fetched from
# the swsoc-simaai-elxr-doc commit deps/artifacts.json pins when that commit has them. The tool and
# the package configs always come from the same tree, as in SiMa's CI (swsoc-elxr
# scripts/build_scripts/elxrPackage.sh uses the checkout's own pkgbuild/).
src="${PIB_PKGBUILD_SRC:-/usr/share/pib/sbp-src}"
if [ ! -f "$src/pkgbuild/sbp/cli.py" ]; then
    echo "sbp: no pkgbuild/sbp at $src; set PIB_PKGBUILD_SRC to a swsoc-simaai-elxr-doc or swsoc-elxr checkout (the pib launcher mounts it)" >&2
    exit 2
fi
PYTHONPATH="$src/pkgbuild${PYTHONPATH:+:$PYTHONPATH}" \
    exec python3 -c 'import sys; sys.argv[0] = "sbp"; from sbp.cli import cli; cli()' "$@"
